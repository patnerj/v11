# ─────────────────────────────────────────────────────────────────────────────
# AlphaCapital Enterprise v11.5 — Environment Configuration Template
# Copy this file to .env.local for local development or set in Vercel / Hostinger
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend WordPress REST API Endpoint (Required)
NEXT_PUBLIC_API_URL=https://api.launchapropfirm.com/wp-json/fxsim/v1
NEXT_PUBLIC_FXSIM_API=https://api.launchapropfirm.com/wp-json/fxsim/v1

# ── Standalone Real-Time WebSocket Gateway (Optional / High-Frequency)
NEXT_PUBLIC_FXSIM_WS_URL=wss://api.launchapropfirm.com/ws

# ── Session & Security Secret (Critical for Production)
# Generate with: openssl rand -hex 32
FXSIM_SESSION_SECRET=e7b92f4c8a1d5e3b6a9f0c2e4d8b1a7f6c3e9a2d5b8e1f4a7c0d3e6b9a2c5f8

# ── Sentry.io Crash & Error Sentinel (Production Monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── White-Label & Image Optimization Whitelist
BRANDING_IMAGE_HOSTS=api.launchapropfirm.com,launchapropfirm.com

# ── Live Chat Integration (Optional)
NEXT_PUBLIC_CHAT_PROVIDER=
NEXT_PUBLIC_CHAT_ID=
NEXT_PUBLIC_CHATWOOT_URL=https://app.chatwoot.com
