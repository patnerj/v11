# PropFirm Launcher — frontend environment
# Copy to `.env.local` and fill in. P1: all vars documented — missing ones
# caused silent vendor-fallback / localhost bugs. Never commit `.env.local`.
#
# Primary backend base (REQUIRED in production — app refuses to boot without it):
NEXT_PUBLIC_API_URL=https://api.yourbrand.com/wp-json/fxsim/v1
# Legacy alias (still honoured, prefer NEXT_PUBLIC_API_URL):
NEXT_PUBLIC_FXSIM_API=https://api.yourbrand.com/wp-json/fxsim/v1
# Server-side absolute URL for Server Components (REQUIRED in production):
FXSIM_API_URL=https://api.yourbrand.com/wp-json/fxsim/v1
# Signed session secret — MUST match backend FXSIM_SESSION_SECRET (REQUIRED):
FXSIM_SESSION_SECRET=generate-with-openssl-rand-hex-32
# Alias (still honoured):
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Public site URL for metadata/branding (REQUIRED in production):
NEXT_PUBLIC_SITE_URL=https://yourbrand.com
# WebSocket fan-out URL (REQUIRED for live prices — no port-guessing):
NEXT_PUBLIC_FXSIM_WS_URL=wss://ws.yourbrand.com
# Optional: pin branding/banner image hosts (comma-separated, else any https):
BRANDING_IMAGE_HOSTS=
# Dev-only: local WP backend for the /api/wp/* rewrite fallback:
LOCAL_WP_BACKEND_URL=http://propfirm.local

# ── Live chat (optional, frontend-only) ─────────────────────────────
# Set a provider and its widget ID to enable a chat bubble site-wide.
# Leave NEXT_PUBLIC_CHAT_PROVIDER empty to disable chat entirely.
#   tawk     → NEXT_PUBLIC_CHAT_ID = your Tawk.to property/widget id (e.g. 5f...x/default-suffix uses the property id portion)
#   crisp    → NEXT_PUBLIC_CHAT_ID = your Crisp CRISP_WEBSITE_ID
#   chatwoot → NEXT_PUBLIC_CHAT_ID = website token; also set NEXT_PUBLIC_CHATWOOT_URL
NEXT_PUBLIC_CHAT_PROVIDER=
NEXT_PUBLIC_CHAT_ID=
NEXT_PUBLIC_CHATWOOT_URL=
